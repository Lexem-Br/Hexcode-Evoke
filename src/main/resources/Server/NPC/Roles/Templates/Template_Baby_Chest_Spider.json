{
  "StartState": "CheckTasks",
  "Type": "Abstract",
  "Invulnerable": false,
  "Parameters": {
    "Appearance": {
      "Value": "Baby_Chest_Spider",
      "Description": "Model to be used."
    },
    "NameTranslationKey": {
      "Value": "Baby Chest Spider",
      "Description": "Translation key for NPC name display"
    }
  },
  "IsMemory": false,
  "BreathesInWater": true,
  "Appearance": {"Compute": "Appearance"},
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Ignore",
  "ApplySeparation": true,
  "SeparationDistance": 1.0,
  "SeparationWeight": 0.6,
  "InventorySize": 0,
  "HotbarSize": 3,
  "OffHandSlots": 1,
  "DefaultOffHandSlot": 0,
  "PickupDropOnDeath": true,
  "MaxHealth": 50,
  "KnockbackScale": 0.5,
  "NameTranslationKey": {"Compute": "NameTranslationKey"},
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 7,
      "Gravity": 10,
      "RunThreshold": 0.3,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 8,
      "MaxClimbHeight": 3,
      "MaxDropHeight": 5
    }
  ],
  "StateTransitions": [
    {
      "$Comment": "Clear",
      "States": [
        {
          "From": [ ],
          "To": [ ]
        }
      ],
      "Actions": [
        {
          "Type": "ReleaseTarget"
        },
        {
          "Type": "ResetInstructions"
        },
        {
          "Type": "PlayAnimation",
          "Slot": "Status"
        }
      ]
    }
  ],
  "Instructions": [
    {
      "$Comment": "Follow the mother",
      "Continue": true,
      "Sensor": {
        "Type": "And",
        "Sensors": [
          {
            "Type": "FlockLeader"
          },
          {
            "Type": "Self",
            "Filters": [
              {
                "Type": "Flock",
                "FlockStatus": "Member"
              }
            ]
          }
        ]
      },
      "BodyMotion": {
        "Type": "Seek",
        "SlowDownDistance": 3,
        "StopDistance": 2,
        "RelativeSpeed": 0.5
      }
    },
    {
      "$Comment": "Despawn if mother not found",
      "Continue": true,
      "Sensor":  {
        "Type": "Not",
        "Sensor": {
          "Type": "FlockLeader"
        }
      },
      "Actions": [
        {
          "Type": "SpawnParticles",
          "Offset": [ 0, 0.5, 0 ],
          "ParticleSystem": "Effect_Death",
          "Once": true
        },
        {
          "Type": "Despawn"
        }
      ]
    },
    {
      "$Comment": "Check tasks to do",
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "CheckTasks"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": ".Default"
          },
          "Instructions": [
            {
              "$Comment": "Start storing items",
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "EvokeIsOnStatus",
                    "Status": "Storing"
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".StoreItems"
                }
              ]
            },
            {
              "$Comment": "Returns to standby mode",
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Standby"
                }
              ]
            }
          ]
        },
        {
          "$Comment": "Start storing items",
          "Sensor": {
            "Type": "State",
            "State": ".StoreItems"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "DisplayName",
                  "DisplayName": "Teste"
                }
              ]
            }
          ]
        },
        {
          "$Comment": "Standby state",
          "Sensor": {
            "Type": "State",
            "State": ".Standby"
          },
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": [3, 3],
              "Action": {
                "Type": "State",
                "State": "CheckTasks"
              }
            }
          ]
        }
      ]
    }
  ]
}