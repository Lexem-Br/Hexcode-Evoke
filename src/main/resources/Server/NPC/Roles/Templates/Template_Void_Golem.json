  "Instructions": [
    {
      "$Comment": "Half health trigger, like the Void Mannequin Mage blink: checked first on every tick, it spends the threshold right away and cancels the melee attack in progress, so the roar starts on the hit that crosses half health instead of waiting for the attack chain and its pause to end.",
      "Continue": true,
      "Sensor": {
        "Type": "And",
        "Sensors": [
          {
            "Type": "Flag",
            "Name": "Void_Golem_Half_Roar_Done",
            "Set": false
          },
          {
            "Type": "Self",
            "Filters": [
