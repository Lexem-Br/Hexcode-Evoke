{
  "StartState": "Following",
  "Type": "Generic",
  "Parameters": {
    "Appearance": {
      "Value": "Hex_Fairy",
      "Description": "Model to be used."
    },
    "FlockArray": {
      "Value": [],
      "TypeHint": "String",
      "Description": "Array containing NPCs for this flock type."
    },
    "DropHexItem": {
      "Value": "Hex_Fairy_Block",
      "Description": "Drop from Hex Creature"
    },
    "holdableItems": {
      "Value": [ "" ],
      "Description": "Items that can be held in the hand"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "MaxBeaconDistance": {
      "Value": 100,
      "Description": "The maximum distance the wand reaches"
    },
    "StopDistance": {
      "Value": 2,
      "Description": "The distance to stop"
    },
    "SFX_Pumpkin_Jump": {
      "Value": "SFX_Pumpkin_Jump_Scary",
      "Description": "The sound in jump-scare mode"
    },
    "SFX_Pumpkin_Laugh": {
      "Value": "SFX_Goblin_Miner_VO_Laugh",
      "Description": "The sound after jump-scare"
    },
    "NameTranslationKey": {
      "Value": "server.npcRoles.Template.name",
      "Description": "Translation key for NPC name display"
    }
  },
  "DropList": { "Compute": "DropList" },
  "Appearance": {"Compute": "Appearance"},
  "FlockSpawnTypes": {"Compute": "FlockArray"},
  "FlockAllowedNPC": {"Compute": "FlockArray"},
  "DisableDamageFlock": true,
  "ApplySeparation": true,
  "SeparationDistance": 1.2,
  "SeparationWeight": 0.6,
  "SeparationLegacySteeringStrength": 0.2,
  "InventorySize": 0,
  "HotbarSize": 3,
  "OffHandSlots": 0,
  "NameTranslationKey": {"Compute": "NameTranslationKey"},
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 12,
      "Gravity": 10,
      "RunThreshold": 0.3,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 10,
      "MaxClimbHeight": 2,
      "MaxDropHeight": 3
    }
  ],
  "MaxHealth": 100,
  "StateTransitions": [
    {
      "$Comment": "Clear",
      "States": [
        {
          "From": [ ],
          "To": [ ]
        }
      ],
      "Actions": [
        {
          "Type": "ReleaseTarget"
        },
        {
          "Type": "ResetInstructions"
        },
        {
          "Type": "PlayAnimation",
          "Slot": "Status"
        }
      ]
    }
  ],
  "Instructions": [
    {
      "$Comment": "Adds the entity to the flock of the first player it finds",
      "Reference": "Component_Evoke_Join_Evoker_Flock"
    },
    {
      "$Comment": "Beacon wand command",
      "Reference": "Component_Evoke_Wand_Commands",
      "Modify": {
        "_ExportStates": ["SeekPosition", "Following"],
        "Range": { "Compute": "MaxBeaconDistance" }
      }
    },
    {
      "$Comment": "Go to target position",
      "Sensor": {
        "Type": "State",
        "State": "SeekPosition"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Evoke:ReadPosition",
            "Range": 30,
            "MinRange": 1
          },
          "BodyMotion": {
            "Type": "Seek",
            "SlowDownDistance": 3,
            "StopDistance": 1,
            "RelativeSpeed": 0.8,
            "RecomputeDistance": 0
          }
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Idle.Default"
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Goes to refuel at a nearby Essence Tray when low on life essence",
      "Reference": "Component_Evoke_Refuel_Trigger",
      "Modify": {
        "_ExportStates": ["Refuel"]
      }
    },
    {
      "$Comment": "Walks to the Essence Tray, consumes as much life essence as it can, walks back to where it was and resumes the previous task",
      "Sensor": {
        "Type": "State",
        "State": "Refuel"
      },
      "Instructions": [
        {
          "Reference": "Component_Evoke_Refuel_Walking"
        }
      ]
    },
    {
      "$Comment": "Less than 1 block away from the player",
      "Continue": true,
      "Sensor": {
        "Type": "Player",
        "Range": 1
      },
      "BodyMotion": {
        "Type": "MaintainDistance",
        "DesiredDistanceRange": [1.5, 1.5],
        "MoveThreshold": 0.2,
        "RelativeForwardsSpeed": 0.6,
        "RelativeBackwardsSpeed": 0.3
      }
    },
    {
      "$Comment": "Target the player",
      "Continue": true,
      "Sensor": {
        "Type": "Player",
        "Range": 3,
        "LockOnTarget": true
      },
      "BodyMotion": {
        "Type": "Nothing"
      }
    },
    {
      "$Comment": "Idle state",
      "Sensor": {
        "Type": "State",
        "State": "Idle"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": ".Default"
          }
        },
        {
          "Sensor": {
            "Type": "State",
            "State": ".JumpScare"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Player",
                "Range": 2.5,
                "LockOnTarget": true
              },
              "ActionsBlocking": true,
              "Actions": [
                {
                  "Type": "PlaySound",
                  "SoundEventId": { "Compute": "SFX_Pumpkin_Jump" },
                  "Once": true
                },
                {
                  "Type": "PlayAnimation",
                  "Slot": "Status",
                  "Animation": "Jump"
                },
                {
                  "Type": "Timeout",
                  "Delay": [1, 1]
                },
                {
                  "Type": "PlaySound",
                  "SoundEventId": { "Compute": "SFX_Pumpkin_Laugh" },
                  "Once": true
                },
                {
                  "Type": "Timeout",
                  "Delay": [10, 10]
                },
                {
                  "Type": "PlayAnimation",
                  "Slot": "Status"
                },
                {
                  "Type": "State",
                  "State": "Idle.JumpScare"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Entity movement",
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": "Following"
          },
          "Instructions": [
            {
              "$Comment": "Less than 5 block away from the leader",
              "Sensor": {
                "Type": "Player",
                "Range": 5,
                "LockOnTarget": true,
                "Filters": [
                  {
                    "Type": "Evoke:IsEvoker"
                  }
                ]
              },
              "HeadMotion": {
                "Type": "Aim",
                "Deflection": true,
                "Spread": 1,
                "RelativeTurnSpeed": 2
              },
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 5,
                "StopDistance": {"Compute": "StopDistance"},
                "RelativeSpeed": 0.4
              }
            },
            {
              "$Comment": "Less than 30 blocks away from the leader",
              "Sensor": {
                "Type": "Player",
                "Range": 30,
                "LockOnTarget": true,
                "Filters": [
                  {
                    "Type": "Evoke:IsEvoker"
                  }
                ]
              },
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 5,
                "StopDistance": 2,
                "RelativeSpeed": 0.6
              }
            },
            {
              "Reference": "Component_Evoke_Teleport_To_Evoker",
              "Modify": {
                "Range": { "Compute": "MaxBeaconDistance" }
              }
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "Instructions": [
      {
        "Sensor": {
          "Type": "Not",
          "Sensor": {
            "Type": "Target",
            "Filters": [
              {
                "Type": "Evoke:IsTargetCrouch"
              }
            ]
          }
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": false,
            "Hint": " "
          }
        ]
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "State",
          "State": "Idle.Default"
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "evoke.interactionHints.ActiveJumpScare"
          }
        ]
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "State",
          "State": "Idle.JumpScare"
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "evoke.interactionHints.DesactiveJumpScare"
          }
        ]
      },
      {
        "$Comment": "Opens the Hex Creature profile, with its inventory",
        "Continue": true,
        "Sensor": {
          "Type": "State",
          "State": "Following"
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "evoke.interactionHints.openInventory"
          }
        ]
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": "Idle.Default"
            },
            {
              "Type": "HasInteracted"
            }
          ]
        },
        "Instructions": [
          {
            "Actions": [
              {
                "Type": "Evoke:SnapToBlockCenter"
              },
              {
                "Type": "State",
                "State": "Idle.JumpScare"
              }
            ]
          }
        ]
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": "Idle.JumpScare"
            },
            {
              "Type": "HasInteracted"
            }
          ]
        },
        "Instructions": [
          {
            "Actions": [
              {
                "Type": "State",
                "State": "Idle.Default"
              }
            ]
          }
        ]
      },
      {
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "State",
              "State": "Following"
            },
            {
              "Type": "HasInteracted"
            },
            {
              "Type": "Target",
              "Filters": [
                {
                  "Type": "Evoke:IsTargetCrouch"
                },
                {
                  "Type": "Evoke:IsEvoker"
                }
              ]
            }
          ]
        },
        "Instructions": [
          {
            "Actions": [
              {
                "Type": "Evoke:OpenHCProfile"
              }
            ]
          }
        ]
      }
    ]
  }
}