    {
      "$Comment": "Idle: waits for a player.",
      "Sensor": {
        "Type": "State",
        "State": "Idle"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Player",
            "Range": {
              "Compute": "DetectionRange"
            },
            "LockOnTarget": true
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Combat"
            }
          ]
        },
        {
          "BodyMotion": {
            "Type": "Sequence",
            "Looped": true,
            "Motions": [
              {
                "Type": "Timer",
                "Time": [
                  2,
                  4
                ],
                "Motion": {
                  "Type": "WanderInCircle",
                  "Radius": {
                    "Compute": "WanderRadius"
                  },
                  "MaxHeadingChange": 60,
                  "RelativeSpeed": 0.3,
                  "MinWalkTime": 1,
                  "RelaxedMoveConstraints": false
                }
              },
              {
                "Type": "Timer",
                "Time": [
                  3,
                  5
                ],
                "Motion": {
                  "Type": "Nothing"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "$Comment": "Combat: keeps KeepDistanceRange from the player with short sideways runs to a random side and long pauses, shooting webs whenever there is a clear line.",
      "Sensor": {
        "Type": "State",
        "State": "Combat"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Not",
            "Sensor": {
              "Type": "Target",
              "Range": {
                "Compute": "DetectionRange"
              }
            }
          },
          "Actions": [
            {
              "Type": "ReleaseTarget"
            },
            {
              "Type": "State",
              "State": "Idle"
            }
          ]
        },
        {
          "$Comment": "No new web while a retreat jump is pending. The web is a blocking Attack + Timeout (the pause between webs) instead of the Attack pause, because that pause is global and would hold the retreat jump back for seconds. Timers are not used here: TimerStart only initialises once.",
          "Continue": true,
          "Sensor": {
            "Type": "Not",
            "Sensor": {
              "Type": "Flag",
              "Name": "Void_Spider_Leaping",
              "Set": true
            }
          },
          "Instructions": [
            {
              "Continue": true,
              "Sensor": {
                "Type": "Target",
                "Range": {
                  "Compute": "WebAttackDistance"
                },
                "Filters": [
                  {
                    "Type": "LineOfSight"
                  }
                ]
              },
              "HeadMotion": {
                "Type": "Aim",
                "HitProbability": 1,
                "Spread": 0,
                "Deflection": false
              },
              "Actions": [
                {
                  "Type": "Attack",
                  "Attack": {
                    "Compute": "WebAttack"
                  },
                  "AimingTimeRange": {
                    "Compute": "WebAimingRange"
                  },
                  "AttackPauseRange": [
                    0,
                    0
                  ]
                },
                {
                  "Type": "Timeout",
                  "Delay": {
                    "Compute": "WebPauseRange"
                  }
                }
              ],
              "ActionsBlocking": true
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Target",
            "Range": {
              "Compute": "DetectionRange"
            }
          },
          "HeadMotion": {
            "Type": "Aim"
          },
          "BodyMotion": {
            "Type": "MaintainDistance",
            "DesiredDistanceRange": {
              "Compute": "KeepDistanceRange"
            },
            "MoveThreshold": 0.5,
            "StrafingDurationRange": {
              "Compute": "ScuttleDurationRange"
            },
            "StrafingFrequencyRange": {
              "Compute": "ScuttlePauseRange"
            },
            "RelativeForwardsSpeed": {
              "Compute": "ScuttleRelativeSpeed"
            }
          }
        }
      ]
