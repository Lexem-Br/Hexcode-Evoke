          "SetTo": true
        },
        {
          "Type": "SetFlag",
          "Name": "Void_Spider_Leaping",
          "SetTo": true
        }
      ]
    },
    {
      "$Comment": "The retreat jump, then one more spiderling released from the opened chest. Runs as one blocking sequence, so nothing else moves the spider (it stands still and keeps watching the player) until it has landed and released the spiderling. The jump starts as soon as the web interaction in progress ends: the webs are paced by a Timeout instead of an attack pause, which would hold the jump back for seconds.",
      "Sensor": {
        "Type": "And",
        "Sensors": [
          {
            "Type": "Target",
            "Range": {
              "Compute": "DetectionRange"
            }
          },
          {
            "Type": "Flag",
            "Name": "Void_Spider_Leaping",
            "Set": true
          }
        ]
      },
      "HeadMotion": {
        "Type": "Watch"
      },
      "BodyMotion": {
        "Type": "Nothing"
      },
      "ActionsBlocking": true,
      "Actions": [
        {
          "Type": "Attack",
          "Attack": "Evoke_Void_Spider_Retreat",
          "SkipAiming": true,
          "AvoidFriendlyFire": false,
          "AttackPauseRange": [
            0,
            0
          ]
        },
        {
          "Type": "Timeout",
          "Delay": {
            "Compute": "makeRange(RetreatJumpWaitTime)"
          }
        },
        {
          "Type": "PlayAnimation",
          "Slot": "Status",
          "Animation": "ChestOpen"
        },
