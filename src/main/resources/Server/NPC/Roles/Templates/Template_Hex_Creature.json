{
  "StartState": "Following",
  "Type": "Abstract",
  "Invulnerable": false,
  "Parameters": {
    "Appearance": {
      "Value": "Hex_Mannequin",
      "Description": "Model to be used."
    },
    "FlockArray": {
      "Value": [],
      "TypeHint": "String",
      "Description": "Array containing NPCs for this flock type."
    },
    "DropHexItem": {
      "Value": "Hex_Mannequin_Block",
      "Description": "Drop from Hex Creature"
    },
    "OffHand": {
      "Value": "",
      "Description": "OffHand items"
    },
    "holdableItems": {
      "Value": [ "Furniture_Crude_Torch" ],
      "Description": "Items that can be held"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "NameTranslationKey": {
      "Value": "Hex Creature",
      "Description": "Translation key for NPC name display"
    }
  },
  "IsMemory": false,
  "BreathesInWater": true,
  "DropList": { "Compute": "DropList" },
  "Appearance": {"Compute": "Appearance"},
  "DisableDamageFlock": false,
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Ignore",
  "FlockSpawnTypes": {"Compute": "FlockArray"},
  "FlockAllowedNPC": {"Compute": "FlockArray"},
  "ApplySeparation": true,
  "SeparationDistance": 2,
  "SeparationWeight": 1,
  "SeparationDistanceTarget": 0.5,
  "SeparationNearRadiusTarget": 1.2,
  "InventorySize": 0,
  "HotbarSize": 3,
  "OffHandSlots": 1,
  "DefaultOffHandSlot": 0,
  "PickupDropOnDeath": true,
  "MaxHealth": 200,
  "KnockbackScale": 0.5,
  "NameTranslationKey": {"Compute": "NameTranslationKey"},
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 12,
      "Gravity": 10,
      "RunThreshold": 0.3,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 10,
      "MaxClimbHeight": 3,
      "MaxDropHeight": 5
    }
  ],
  "StateTransitions": [
    {
      "$Comment": "Clear",
      "States": [
        {
          "From": [ ],
          "To": [ ]
        }
      ],
      "Actions": [
        {
          "Type": "ReleaseTarget"
        },
        {
          "Type": "ResetInstructions"
        },
        {
          "Type": "PlayAnimation",
          "Slot": "Status"
        }
      ]
    }
  ],
  "Instructions": [
    {
      "$Comment": "Adds the entity to the player flock",
      "Continue": true,
      "Instructions": [
        {
          "$Comment": "Add creature to flock",
          "Continue": true,
          "Sensor": {
            "Type": "Self",
            "Filters": [
              {
                "Type": "Flock",
                "FlockStatus": "NotMember"
              }
            ]
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Player",
                "Range": 15,
                "Filters": [
                  {
                    "Type": "IsEvoker"
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "JoinFlock",
                  "ForceJoin": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Pick up item",
      "Continue": true,
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "Not",
            "Sensor": {
              "Type": "Self",
              "Filters": [
                {
                  "Type": "EvokeIsInventoryFull",
                  "Inventories": ["Hotbar", "Storage"]
                }
              ]
            }
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "DroppedItem",
                "Range": 2,
                "Items": { "Compute": "holdableItems" }
              },
              "Actions": [
                {
                  "Type": "HCPickUpItem",
                  "Items": { "Compute": "holdableItems" },
                  "Hoover": true
                }
              ],
              "BodyMotion": {
                "Type": "Seek",
                "StopDistance": 0.5
              }
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Beacon wand command",
      "Continue": true,
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "FlockLeader"
          },
          "Instructions": [
            {
              "$Comment": "Store target position",
              "Sensor": {
                "Type": "Beacon",
                "Message": "EvokeTargetPosition",
                "Range": 90
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "SeekPosition"
                }
              ]
            },
            {
              "$Comment": "Follow the leader",
              "Sensor": {
                "Type": "Beacon",
                "Message": "EvokeFollowLeader",
                "Range": 100
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "Following"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Go to target position",
      "Sensor": {
        "Type": "State",
        "State": "SeekPosition"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "EvokeReadPosition",
            "Range": 30
          },
          "BodyMotion": {
            "Type": "Seek",
            "SlowDownDistance": 3,
            "StopDistance": 1,
            "RelativeSpeed": 0.8,
            "RecomputeDistance": 0
          }
        },
        {
          "Sensor": {
            "Type": "EvokeReadPosition",
            "Range": 2
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Idle.Default"
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Entity movement",
      "Sensor": {
        "Type": "State",
        "State": "Following"
      },
      "Instructions": [
        {
          "$Comment": "Less than 1 block away from the leader",
          "Sensor": {
            "Type": "Player",
            "Range": 1,
            "LockOnTarget": true,
            "Filters": [
              {
                "Type": "IsEvoker"
              }
            ]
          },
          "HeadMotion": {
            "Type": "Aim",
            "Deflection": true,
            "Spread": 1
          },
          "BodyMotion": {
            "Type": "MaintainDistance",
            "DesiredDistanceRange": [1.5, 1.5],
            "MoveThreshold": 0.2,
            "RelativeForwardsSpeed": 0.6,
            "RelativeBackwardsSpeed": 0.3
          }
        },
        {
          "$Comment": "Less than 40 blocks away from the leader",
          "Sensor": {
            "Type": "Player",
            "Range": 40,
            "LockOnTarget": true,
            "Filters": [
              {
                "Type": "IsEvoker"
              }
            ]
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Target"
              },
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 5,
                "StopDistance": 3,
                "RelativeSpeed": 0.5
              }
            }
          ]
        },
        {
          "$Comment": "Teleports to the leader if more than 40 blocks away",
          "Sensor": {
            "Type": "Target",
            "Filters": [
              {
                "Type": "IsEvoker"
              }
            ]
          },
          "BodyMotion": {
            "Type": "Teleport",
            "OffsetRange": [2, 3],
            "OffsetSector": 2,
            "Orientation": "TowardsTarget"
          },
          "Actions": [
            {
              "Type": "SpawnParticles",
              "Offset": [ 0, 0.5, 0 ],
              "ParticleSystem": "Effect_Death",
              "Once": true
            },
            {
              "Type": "Timeout",
              "Delay": [ 2, 2 ],
              "DelayAfter": true
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Idle state",
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "Idle"
      },
      "Instructions": [
        {
          "$Comment": "Verify item being held",
          "Sensor": {
            "Type": "State",
            "State": ".Default"
          },
          "Instructions": [
            {
              "$Comment": "Checks if you are holding a sickle",
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "ItemInHand",
                    "Items": [ "Tool_Sickle*" ]
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Harvest"
                }
              ]
            }
          ]
        },
        {
          "$Comment": "Search for a plantation that is ready to harvest",
          "Sensor": {
            "Type": "State",
            "State": ".Harvest"
          },
          "Instructions": [
            {
              "Reference": "Component_Evoke_harvest",
              "Modify": {
                "_ExportStates": ["SeekPosition"]
              }
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "$Comment": "Opens the Hex Creature profile when interacted with",
    "Instructions": [
      {
        "Continue": true,
        "Sensor": {
          "Type": "Any"
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true
          }
        ]
      },
      {
        "Sensor": {
          "Type": "HasInteracted"
        },
        "Instructions": [
          {
            "Actions": [
              {
                "Type": "OpenHCProfile"
              }
            ]
          }
        ]
      }
    ]
  }
}