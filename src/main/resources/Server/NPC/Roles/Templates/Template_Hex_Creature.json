{
  "StartState": "Following",
  "Type": "Abstract",
  "Invulnerable": false,
  "Parameters": {
    "Appearance": {
      "Value": "Hex_Mannequin",
      "Description": "Model to be used."
    },
    "DropHexItem": {
      "Value": "Hex_Mannequin_Block",
      "Description": "Drop from Hex Creature"
    },
    "OffHand": {
      "Value": "",
      "Description": "OffHand items"
    },
    "holdableItems": {
      "Value": [ "Furniture_Crude_Torch" ],
      "Description": "Items that can be held"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "NameTranslationKey": {
      "Value": "Hex Creature",
      "Description": "Translation key for NPC name display"
    }
  },
  "IsMemory": false,
  "BreathesInWater": true,
  "DropList": { "Compute": "DropList" },
  "Appearance": {"Compute": "Appearance"},
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Ignore",
  "ApplySeparation": true,
  "SeparationDistance": 1.0,
  "SeparationWeight": 0.6,
  "SeparationLegacySteeringStrength": 0.2,
  "InventorySize": 0,
  "HotbarSize": 6,
  "OffHandSlots": 1,
  "DefaultOffHandSlot": 0,
  "PickupDropOnDeath": true,
  "MaxHealth": 200,
  "KnockbackScale": 0.5,
  "NameTranslationKey": {"Compute": "NameTranslationKey"},
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 8,
      "Gravity": 10,
      "RunThreshold": 0.3,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 8,
      "MaxClimbHeight": 3,
      "MaxDropHeight": 5
    }
  ],
  "StateTransitions": [
    {
      "$Comment": "Clear",
      "States": [
        {
          "From": [ ],
          "To": [ ]
        }
      ],
      "Actions": [
        {
          "Type": "ReleaseTarget"
        },
        {
          "Type": "ResetInstructions"
        },
        {
          "Type": "PlayAnimation",
          "Slot": "Status"
        }
      ]
    }
  ],
  "Instructions": [
    {
      "$Comment": "Beacon wand command",
      "Reference": "Component_Evoke_Wand_Commands",
      "Modify": {
        "_ExportStates": ["SeekPosition", "Following"],
        "Range": 100
      }
    },
    {
      "$Comment": "Shows a broken sickle thought when a player comes close while the sickle in hand is broken",
      "Continue": true,
      "Sensor": {
        "Type": "And",
        "Sensors": [
          {
            "Type": "Flag",
            "Name": "BrokenSickleThought",
            "Set": false
          },
          {
            "Type": "Self",
            "Filters": [
              {
                "Type": "Evoke:HasBrokenItemInHand",
                "Items": [ "Tool_Sickle*" ]
              }
            ]
          },
          {
            "Type": "Player",
            "Range": 5
          }
        ]
      },
      "Actions": [
        {
          "Type": "SpawnParticles",
          "TargetNodeName": "Head",
          "ParticleSystem": "Evoke_Thought_Broken_Sickle",
          "Offset": [ 0, 0.7, 0 ]
        },
        {
          "Type": "SetFlag",
          "Name": "BrokenSickleThought",
          "SetTo": true
        }
      ]
    },
    {
      "$Comment": "Allows the broken sickle thought again once no player is close or the sickle is no longer broken",
      "Continue": true,
      "Sensor": {
        "Type": "And",
        "Sensors": [
          {
            "Type": "Flag",
            "Name": "BrokenSickleThought"
          },
          {
            "Type": "Or",
            "Sensors": [
              {
                "Type": "Not",
                "Sensor": {
                  "Type": "Player",
                  "Range": 8
                }
              },
              {
                "Type": "Not",
                "Sensor": {
                  "Type": "Self",
                  "Filters": [
                    {
                      "Type": "Evoke:HasBrokenItemInHand",
                      "Items": [ "Tool_Sickle*" ]
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "Actions": [
        {
          "Type": "SetFlag",
          "Name": "BrokenSickleThought",
          "SetTo": false
        }
      ]
    },
    {
      "$Comment": "Go to target position",
      "Sensor": {
        "Type": "State",
        "State": "SeekPosition"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "Evoke:ReadPosition",
            "Range": 30,
            "MinRange": 1
          },
          "BodyMotion": {
            "Type": "Seek",
            "SlowDownDistance": 3,
            "StopDistance": 0.1,
            "RelativeSpeed": 0.8
          }
        },
        {
          "Sensor": {
            "Type": "Evoke:ReadPosition",
            "Range": 2,
            "MinRange": 1
          },
          "Actions": [
            {
              "Type": "State",
              "State": "CheckTasks.Default"
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Goes to refuel at a nearby Essence Tray when low on life essence",
      "Reference": "Component_Evoke_Refuel_Trigger",
      "Modify": {
        "_ExportStates": ["Refuel"]
      }
    },
    {
      "$Comment": "Walks to the Essence Tray, consumes as much life essence as it can, walks back to where it was and resumes the previous task",
      "Sensor": {
        "Type": "State",
        "State": "Refuel"
      },
      "Instructions": [
        {
          "Reference": "Component_Evoke_Refuel_Walking"
        }
      ]
    },
    {
      "$Comment": "Less than 1 block away from the player",
      "Sensor": {
        "Type": "Player",
        "Range": 1
      },
      "BodyMotion": {
        "Type": "MaintainDistance",
        "DesiredDistanceRange": [1.5, 1.5],
        "MoveThreshold": 0.2,
        "RelativeForwardsSpeed": 0.6,
        "RelativeBackwardsSpeed": 0.3
      }
    },
    {
      "$Comment": "Head motion",
      "Continue": true,
      "Sensor": {
        "Type": "Player",
        "Range": 2,
        "Filters": [
          {
            "Type": "ViewSector",
            "ViewSector": 120
          }
        ]
      },
      "HeadMotion": {
        "Type": "Watch",
        "RelativeTurnSpeed": 0.5
      }
    },
    {
      "$Comment": "Entity movement",
      "Sensor": {
        "Type": "State",
        "State": "Following"
      },
      "Instructions": [
        {
          "Reference": "Component_Evoke_Follow_Evoker_Walking"
        }
      ]
    },
    {
      "$Comment": "Check tasks to do",
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "CheckTasks"
      },
      "Instructions": [
        {
          "$Comment": "Verify item being held",
          "Sensor": {
            "Type": "State",
            "State": ".Default"
          },
          "Instructions": [
            {
              "$Comment": "Checks if the inventory is full and if there is a chest nearby",
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "Evoke:IsInventoryFull",
                    "Inventories": ["Hotbar", "Storage"]
                  },
                  {
                    "Type": "Evoke:HasChestNearby",
                    "HorizontalRange": 15,
                    "VerticalRange": 3
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".StoreItems"
                }
              ]
            },
            {
              "$Comment": "Checks if you are holding a sickle that is not broken and if has harvestable crop",
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "Evoke:HasUsableItemInHand",
                    "Items": [ "Tool_Sickle*" ]
                  },
                  {
                    "Type": "Evoke:HasHarvestableCrop",
                    "HorizontalRange": 15,
                    "VerticalRange": 3
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Harvest"
                }
              ]
            },
            {
              "$Comment": "Checks if you are holding a watering can with water and if has dry soil",
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "Evoke:HasWateringCan",
                    "Filled": true
                  },
                  {
                    "Type": "Evoke:HasWettableSoil",
                    "HorizontalRange": 15,
                    "VerticalRange": 3
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Water"
                }
              ]
            },
            {
              "$Comment": "Checks if you are holding an empty watering can, if has dry soil and water nearby to fill it",
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "Evoke:HasWateringCan",
                    "Filled": false
                  },
                  {
                    "Type": "Evoke:HasWettableSoil",
                    "HorizontalRange": 15,
                    "VerticalRange": 3
                  },
                  {
                    "Type": "Evoke:HasWaterSourceNearby",
                    "HorizontalRange": 15,
                    "VerticalRange": 3
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Water"
                }
              ]
            },
            {
              "$Comment": "Checks if you are holding a fertilizer and if has soil to fertilize",
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "ItemInHand",
                    "Items": [ "Tool_Fertilizer" ]
                  },
                  {
                    "Type": "Evoke:HasFertilizableSoil",
                    "HorizontalRange": 15,
                    "VerticalRange": 3
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Fertilize"
                }
              ]
            },
            {
              "$Comment": "Stores the items when there is no task to do",
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "Evoke:HasItemsOnInventory",
                    "Inventories": ["Hotbar", "Storage"],
                    "SkipHotbarSlotZero": true
                  },
                  {
                    "Type": "Evoke:HasChestNearby",
                    "HorizontalRange": 15,
                    "VerticalRange": 3,
                    "CheckCanStore": true
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".StoreItems"
                }
              ]
            },
            {
              "$Comment": "Returns to standby mode",
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Standby"
                }
              ]
            }
          ]
        },
        {
          "$Comment": "Search for a chest that has available slots",
          "Sensor": {
            "Type": "State",
            "State": ".StoreItems"
          },
          "Instructions": [
            {
              "Reference": "Component_Evoke_Store_Items",
              "Modify": {
                "_ExportStates": ["SeekPosition"]
              }
            }
          ]
        },
        {
          "$Comment": "Search for a plantation that is ready to harvest",
          "Sensor": {
            "Type": "State",
            "State": ".Harvest"
          },
          "Instructions": [
            {
              "Reference": "Component_Evoke_Harvest",
              "Modify": {
                "_ExportStates": ["SeekPosition"]
              }
            }
          ]
        },
        {
          "$Comment": "Search for a dry soil",
          "Sensor": {
            "Type": "State",
            "State": ".Water"
          },
          "Instructions": [
            {
              "Reference": "Component_Evoke_Water",
              "Modify": {
                "_ExportStates": ["SeekPosition"]
              }
            }
          ]
        },
        {
          "$Comment": "Search for soil to fertilize",
          "Sensor": {
            "Type": "State",
            "State": ".Fertilize"
          },
          "Instructions": [
            {
              "Reference": "Component_Evoke_Fertilize",
              "Modify": {
                "_ExportStates": ["SeekPosition"]
              }
            }
          ]
        },
        {
          "$Comment": "Standby state",
          "Sensor": {
            "Type": "State",
            "State": ".Standby"
          },
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": [3, 3],
              "Action": {
                "Type": "State",
                "State": "CheckTasks"
              }
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "Reference": "Component_Evoke_Interaction_Profile"
  }
}