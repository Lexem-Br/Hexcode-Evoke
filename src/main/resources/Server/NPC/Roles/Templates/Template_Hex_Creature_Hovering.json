{
  "StartState": "Following",
  "Type": "Generic",
  "Parameters": {
    "Appearance": {
      "Value": "Hex_Fairy",
      "Description": "Model to be used."
    },
    "FlockArray": {
      "Value": [],
      "TypeHint": "String",
      "Description": "Array containing NPCs for this flock type."
    },
    "DropHexItem": {
      "Value": "Hex_Fairy_Block",
      "Description": "Drop from Hex Creature"
    },
    "holdableItems": {
      "Value": [ "" ],
      "Description": "Items that can be held in the hand"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "MaxBeaconDistance": {
      "Value": 100,
      "Description": "The maximum distance the wand reaches"
    },
    "NameTranslationKey": {
      "Value": "server.npcRoles.Template.name",
      "Description": "Translation key for NPC name display"
    }
  },
  "DropList": { "Compute": "DropList" },
  "Appearance": {"Compute": "Appearance"},
  "FlockSpawnTypes": {"Compute": "FlockArray"},
  "FlockAllowedNPC": {"Compute": "FlockArray"},
  "DisableDamageFlock": true,
  "ApplySeparation": true,
  "SeparationDistance": 0.5,
  "SeparationWeight": 0.5,
  "SeparationDistanceTarget": 1,
  "SeparationNearRadiusTarget": 1.2,
  "InventorySize": 0,
  "HotbarSize": 3,
  "OffHandSlots": 0,
  "ApplyAvoidance": true,
  "AvoidanceMode": "Slowdown",
  "NameTranslationKey": {"Compute": "NameTranslationKey"},
  "InitialMotionController": "Walk",
  "MotionControllerList": [
    {
      "$Comment": "Only used right after spawning or when touching the ground, the creature takes off right away",
      "Type": "Walk",
      "MaxWalkSpeed": 15,
      "Gravity": 10,
      "RunThreshold": 0.5,
      "MaxFallSpeed": 30,
      "MaxRotationSpeed": 360,
      "Acceleration": 20,
      "MinHover": 1,
      "MaxHover": 1,
      "HoverFreq": 10,
      "MaxClimbHeight": 3,
      "MaxDropHeight": 3
    },
    {
      "$Comment": "MinAirSpeed 0 lets the creature stop and hover in place instead of circling like a bird",
      "Type": "Fly",
      "MaxHorizontalSpeed": 15,
      "MaxClimbSpeed": 10,
      "MaxSinkSpeed": 8,
      "MinAirSpeed": 0,
      "Acceleration": 20,
      "Deceleration": 10,
      "MaxClimbAngle": 90,
      "MaxSinkAngle": 90,
      "MaxTurnSpeed": 180,
      "MaxRollAngle": 20,
      "MinHeightOverGround": 1,
      "MaxHeightOverGround": 3,
      "DesiredAltitudeWeight": 0.5
    }
  ],
  "MaxHealth": 100,
  "StateTransitions": [
    {
      "$Comment": "Clear",
      "States": [
        {
          "From": [ ],
          "To": [ ]
        }
      ],
      "Actions": [
        {
          "Type": "ReleaseTarget"
        },
        {
          "Type": "ResetInstructions"
        }
      ]
    }
  ],
  "Instructions": [
    {
      "$Comment": "After the Follow command, the target flies directly to the summoner through any block and returns to the Following command when nearby",
      "Sensor": {
        "Type": "State",
        "State": "Recall"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "MotionController",
            "MotionController": "Walk"
          },
          "Actions": [
            {
              "Type": "Evoke:SetMotionController",
              "MotionController": "Fly"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Beacon",
            "Message": "EvokeTargetPosition",
            "Range": { "Compute": "MaxBeaconDistance" }
          },
          "Actions": [
            {
              "Type": "State",
              "State": "SeekPosition"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Evoke:EvokerPosition",
            "Range": 2
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Following"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Evoke:Unstuck",
              "Speed": 8,
              "TurnRate": 10,
              "StartSpread": 90
            }
          ]
        }
      ]
    },
    {
      "$Comment": "After the wand command flies straight to 1.5 blocks above the target point through any block, then waits there",
      "Sensor": {
        "Type": "State",
        "State": "SeekPosition"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "MotionController",
            "MotionController": "Walk"
          },
          "Actions": [
            {
              "Type": "Evoke:SetMotionController",
              "MotionController": "Fly"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Beacon",
            "Message": "EvokeFollowLeader",
            "Range": { "Compute": "MaxBeaconDistance" }
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Recall"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Evoke:ReadPosition",
            "Range": { "Compute": "MaxBeaconDistance" },
            "MinRange": 0.3,
            "HeightOffset": 1.5
          },
          "Actions": [
            {
              "Type": "Evoke:Unstuck",
              "Speed": 8,
              "TurnRate": 10,
              "StartSpread": 90
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Idle"
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Flies straight to above the Essence Tray through any block, consumes as much life essence as it can, flies back to where it was and resumes the previous task",
      "Sensor": {
        "Type": "State",
        "State": "Refuel"
      },
      "Instructions": [
        {
          "$Comment": "Wand commands still work while refueling",
          "Reference": "Component_Evoke_Wand_Commands",
          "Modify": {
            "_ExportStates": ["SeekPosition", "Recall"],
            "Range": { "Compute": "MaxBeaconDistance" }
          }
        },
        {
          "Reference": "Component_Evoke_Refuel_Flying"
        }
      ]
    },
    {
      "$Comment": "Switches back to Walk if the creature touches the ground while flying, so it can take off again",
      "Continue": true,
      "Sensor": {
        "Type": "And",
        "Sensors": [
          {
            "Type": "MotionController",
            "MotionController": "Fly"
          },
          {
            "Type": "OnGround"
          }
        ]
      },
      "Actions": [
        {
          "Type": "Evoke:SetMotionController",
          "MotionController": "Walk"
        }
      ]
    },
    {
      "$Comment": "While stuck against a block, flies straight through the blocks to the evoker (or to the wand target)",
      "Continue": true,
      "Sensor": {
        "Type": "Evoke:IsStuck",
        "Delay": 0.15,
        "MinProgress": 0.5,
        "MaxStuckTime": 2
      },
      "Actions": [
        {
          "Type": "Evoke:Unstuck",
          "Speed": 4
        }
      ]
    },
    {
      "$Comment": "Takes off whenever the creature is not flying",
      "Sensor": {
        "Type": "MotionController",
        "MotionController": "Walk"
      },
      "BodyMotion": {
        "Type": "TakeOff",
        "JumpSpeed": 4
      }
    },
    {
      "$Comment": "Adds the entity to the flock of the first player it finds",
      "Reference": "Component_Evoke_Join_Evoker_Flock"
    },
    {
      "$Comment": "Beacon wand command",
      "Reference": "Component_Evoke_Wand_Commands",
      "Modify": {
        "_ExportStates": ["SeekPosition", "Recall"],
        "Range": { "Compute": "MaxBeaconDistance" }
      }
    },
    {
      "$Comment": "Goes to refuel at a nearby Essence Tray when low on life essence",
      "Reference": "Component_Evoke_Refuel_Trigger",
      "Modify": {
        "_ExportStates": ["Refuel"]
      }
    },
    {
      "$Comment": "Idle state",
      "Sensor": {
        "Type": "State",
        "State": "Idle"
      }
    },
    {
      "$Comment": "Entity movement",
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": "Following"
          },
          "Instructions": [
            {
              "$Comment": "Prevents the NPC from losing sight of the player",
              "Continue": true,
              "Sensor": {
                "Type": "Player",
                "Range": { "Compute": "MaxBeaconDistance" },
                "LockOnTarget": true,
                "Filters": [
                  {
                    "Type": "Evoke:IsEvoker"
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "Nothing"
                }
              ]
            },
            {
              "$Comment": "Less than 5 block away from the leader, flies at the player's head height, ahead of them while they walk",
              "Sensor": {
                "Type": "Evoke:EvokerPosition",
                "Range": 5,
                "HeightOffset": 1.5,
                "LeadDistance": 4,
                "LeadFullSpeed": 5,
                "LeadSideOffset": 1.5
              },
              "HeadMotion": {
                "Type": "Aim",
                "RelativeTurnSpeed": 2
              },
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 4,
                "StopDistance": 2,
                "RelativeSpeed": 0.6,
                "DesiredAltitudeWeight": 0
              }
            },
            {
              "$Comment": "Less than 15 blocks away from the leader, flies at the player's head height, ahead of them while they walk",
              "Sensor": {
                "Type": "Evoke:EvokerPosition",
                "Range": 15,
                "HeightOffset": 1.5,
                "LeadDistance": 4,
                "LeadFullSpeed": 5,
                "LeadSideOffset": 1.5
              },
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 4,
                "StopDistance": 2,
                "RelativeSpeed": 0.8,
                "DesiredAltitudeWeight": 0
              }
            },
            {
              "Reference": "Component_Evoke_Teleport_To_Evoker",
              "Modify": {
                "Range": { "Compute": "MaxBeaconDistance" }
              }
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "Reference": "Component_Evoke_Interaction_Crouch_Profile"
  }
}