{
  "StartState": "Idle",
  "Type": "Generic",
  "Parameters": {
    "Appearance": {
      "Value": "Hex_Broom",
      "Description": "Model to be used."
    },
    "FlockArray": {
      "Value": [],
      "TypeHint": "String",
      "Description": "Array containing NPCs for this flock type."
    },
    "DropHexItem": {
      "Value": "Hex_Broom_Block",
      "Description": "Drop from Hex Creature"
    },
    "holdableItems": {
      "Value": [ "" ],
      "Description": "Items that can be held in the hand"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "MaxBeaconDistance": {
      "Value": 100,
      "Description": "The maximum distance the wand reaches"
    },
    "StopDistance": {
      "Value": 2,
      "Description": "The distance to stop"
    },
    "NameTranslationKey": {
      "Value": "server.npcRoles.Template.name",
      "Description": "Translation key for NPC name display"
    }
  },
  "DropList": { "Compute": "DropList" },
  "Appearance": {"Compute": "Appearance"},
  "FlockSpawnTypes": {"Compute": "FlockArray"},
  "FlockAllowedNPC": {"Compute": "FlockArray"},
  "DisableDamageFlock": true,
  "ApplySeparation": true,
  "SeparationDistance": 1.2,
  "SeparationWeight": 0.6,
  "SeparationLegacySteeringStrength": 0.2,
  "InventorySize": 5,
  "HotbarSize": 3,
  "OffHandSlots": 0,
  "NameTranslationKey": {"Compute": "NameTranslationKey"},
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 3,
      "Gravity": 10,
      "RunThreshold": 0.3,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 3,
      "MaxClimbHeight": 1,
      "MaxDropHeight": 2
    }
  ],
  "MaxHealth": 50,
  "StateTransitions": [
    {
      "$Comment": "Clear",
      "States": [
        {
          "From": [ ],
          "To": [ ]
        }
      ],
      "Actions": [
        {
          "Type": "ReleaseTarget"
        },
        {
          "Type": "ResetInstructions"
        },
        {
          "Type": "PlayAnimation",
          "Slot": "Status"
        }
      ]
    }
  ],
  "Instructions": [
    {
      "$Comment": "Adds the entity to the flock to prevent flock damage",
      "Continue": true,
      "Sensor": {
        "Type": "Self",
        "Filters": [
          {
            "Type": "Flock",
            "FlockStatus": "NotMember"
          }
        ]
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Player",
            "Range": 15,
            "Filters": [
              {
                "Type": "Evoke:IsEvoker"
              }
            ]
          },
          "Actions": [
            {
              "Type": "JoinFlock",
              "ForceJoin": true
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Beacon wand command, placed before the states so it works in all of them",
      "Reference": "Component_Evoke_Wand_Commands",
      "Modify": {
        "_ExportStates": ["SeekPosition", "Following"],
        "Range": { "Compute": "MaxBeaconDistance" }
      }
    },
    {
      "$Comment": "Go to target position",
      "Sensor": {
        "Type": "State",
        "State": "SeekPosition"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "Evoke:ReadPosition",
            "Range": 30,
            "MinRange": 1
          },
          "BodyMotion": {
            "Type": "Seek",
            "SlowDownDistance": 3,
            "StopDistance": 1,
            "RelativeSpeed": 0.8,
            "RecomputeDistance": 0
          }
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Idle"
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Goes to refuel at a nearby Essence Tray when low on life essence",
      "Reference": "Component_Evoke_Refuel_Trigger",
      "Modify": {
        "_ExportStates": ["Refuel"]
      }
    },
    {
      "$Comment": "Walks to the Essence Tray, consumes as much life essence as it can, walks back to where it was and resumes the previous task",
      "Sensor": {
        "Type": "State",
        "State": "Refuel"
      },
      "Instructions": [
        {
          "Reference": "Component_Evoke_Refuel_Walking"
        }
      ]
    },
    {
      "$Comment": "Less than 1 block away from the player",
      "Sensor": {
        "Type": "Player",
        "Range": 1
      },
      "BodyMotion": {
        "Type": "MaintainDistance",
        "DesiredDistanceRange": [1.5, 1.5],
        "MoveThreshold": 0.2,
        "RelativeForwardsSpeed": 0.6,
        "RelativeBackwardsSpeed": 0.3
      }
    },
    {
      "$Comment": "Wanders the area, sweeping",
      "Sensor": {
        "Type": "State",
        "State": "Idle"
      },
      "Instructions": [
        {
          "$Comment": "Store the items in a chest once there is nothing left to pick up nearby or the inventory is full",
          "Continue": true,
          "Sensor": {
            "Type": "And",
            "Sensors": [
              {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "Inventory",
                    "Items": [ "*" ]
                  },
                  {
                    "Type": "Evoke:HasChestNearby",
                    "HorizontalRange": 15,
                    "VerticalRange": 2
                  }
                ]
              },
              {
                "Type": "Or",
                "Sensors": [
                  {
                    "Type": "Not",
                    "Sensor": {
                      "Type": "DroppedItem",
                      "Range": 15,
                      "Items": [ "*" ]
                    }
                  },
                  {
                    "Type": "Self",
                    "Filters": [
                      {
                        "Type": "Evoke:IsInventoryFull",
                        "Inventories": [ "Hotbar", "Storage" ]
                      }
                    ]
                  }
                ]
              }
            ]
          },
          "Actions": [
            {
              "Type": "State",
              "State": "FindChest"
            }
          ]
        },
        {
          "$Comment": "Stops collecting after a while and stores what was collected, in case an item cannot be reached",
          "Continue": true,
          "Sensor": {
            "Type": "Self",
            "Filters": [
              {
                "Type": "Inventory",
                "Items": [ "*" ]
              },
              {
                "Type": "Evoke:HasChestNearby",
                "HorizontalRange": 15,
                "VerticalRange": 2
              }
            ]
          },
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": [10, 10],
              "Action": {
                "Type": "State",
                "State": "FindChest"
              }
            }
          ]
        },
        {
          "Sensor": {
            "Type": "DroppedItem",
            "Range": 15,
            "Items": [ "*" ]
          },
          "BodyMotion": {
            "Type": "Sequence",
            "Looped": true,
            "Motions": [
              {
                "Type": "Timer",
                "Time": [ 1.0, 1.0 ],
                "Motion": {
                  "Type": "Nothing"
                }
              },
              {
                "Type": "Seek",
                "SlowDownDistance": 0.5,
                "StopDistance": 0.5,
                "RecomputeDistance": 1
              }
            ]
          },
          "ActionsBlocking": true,
          "Actions": [
            {
              "Type": "PlayAnimation",
              "Slot": "Status",
              "Animation": "Jump"
            },
            {
              "Type": "Timeout",
              "Delay": [1, 1]
            },
            {
              "Type": "PlayAnimation",
              "Slot": "Status"
            },
            {
              "Type": "PickUpItem",
              "Range": 1,
              "StorageTarget": "Inventory"
            }
          ]
        },
        {
          "BodyMotion": {
            "Type": "Sequence",
            "Looped": true,
            "Motions": [
              {
                "Type": "Timer",
                "Time": [ 16, 20 ],
                "Motion": {
                  "Type": "WanderInCircle",
                  "Radius": 20,
                  "MaxHeadingChange": 45,
                  "RelativeSpeed": 0.15
                }
              },
              {
                "Type": "Timer",
                "Time": [ 0.5, 1.5 ],
                "Motion": {
                  "Type": "Nothing"
                }
              },
              {
                "Type": "Timer",
                "Time": [ 14, 18 ],
                "Motion": {
                  "Type": "WanderInCircle",
                  "Radius": 5,
                  "MaxHeadingChange": 45,
                  "RelativeSpeed": 0.15
                }
              },
              {
                "Type": "Timer",
                "Time": [ 0.5, 1.5 ],
                "Motion": {
                  "Type": "Nothing"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "Sensor": {
        "Type": "State",
        "State": "FindChest"
      },
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": ".Default"
          },
          "Instructions": [
            {
              "$Comment": "Checks if there is a chest nearby",
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "Evoke:HasChestNearby",
                    "HorizontalRange": 30,
                    "VerticalRange": 2
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".StoreItems"
                }
              ]
            },
            {
              "$Comment": "Returns to Idle mode",
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "Idle"
                }
              ]
            }
          ]
        },
        {
          "$Comment": "Search for a chest that has available slots",
          "Sensor": {
            "Type": "State",
            "State": ".StoreItems"
          },
          "Instructions": [
            {
              "Reference": "Component_Evoke_Store_Items",
              "Modify": {
                "_ExportStates": ["Idle"]
              }
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Follow the player",
      "Sensor": {
        "Type": "State",
        "State": "Following"
      },
      "Instructions": [
        {
          "$Comment": "Less than 5 block away from the leader",
          "Sensor": {
            "Type": "Player",
            "Range": 5,
            "LockOnTarget": true,
            "Filters": [
              {
                "Type": "Evoke:IsEvoker"
              }
            ]
          },
          "HeadMotion": {
            "Type": "Aim",
            "Deflection": true,
            "Spread": 1,
            "RelativeTurnSpeed": 2
          },
          "BodyMotion": {
            "Type": "Seek",
            "SlowDownDistance": 5,
            "StopDistance": {"Compute": "StopDistance"},
            "RelativeSpeed": 0.4
          }
        },
        {
          "$Comment": "Less than 30 blocks away from the leader",
          "Sensor": {
            "Type": "Player",
            "Range": 30,
            "LockOnTarget": true,
            "Filters": [
              {
                "Type": "Evoke:IsEvoker"
              }
            ]
          },
          "BodyMotion": {
            "Type": "Seek",
            "SlowDownDistance": 5,
            "StopDistance": 2,
            "RelativeSpeed": 0.6
          }
        },
        {
          "Reference": "Component_Evoke_Teleport_To_Evoker",
          "Modify": {
            "Range": { "Compute": "MaxBeaconDistance" }
          }
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "Reference": "Component_Evoke_Interaction_Profile"
  }
}