{
  "StartState": "Following",
  "Type": "Generic",
  "Parameters": {
    "Appearance": {
      "Value": "Arcane_Codex",
      "Description": "Model to be used."
    },
    "FlockArray": {
      "Value": [],
      "TypeHint": "String",
      "Description": "Array containing NPCs for this flock type."
    },
    "DropHexItem": {
      "Value": "Recipe_Book_Magic_Void",
      "Description": "Drop from Hex Creature"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "MaxBeaconDistance": {
      "Value": 100,
      "Description": "The maximum distance the wand reaches"
    },
    "ChestHorizontalRange": {
      "Value": 16,
      "Description": "Horizontal distance of the chests the book memorizes"
    },
    "ChestVerticalRange": {
      "Value": 4,
      "Description": "Vertical distance of the chests the book memorizes"
    },
    "FollowFormation": {
      "Value": "Nearest",
      "Description": "Where the book flies while following: Lead (ahead of the evoker while they walk), Behind, Side or Nearest (opposite to the walking direction)"
    },
    "FollowDistance": {
      "Value": 1,
      "Description": "Distance from the evoker in the Behind and Side formations"
    },
    "FollowSide": {
      "Value": "Nearest",
      "Description": "Side of the Side formation: Nearest (the side it is already on), Left or Right"
    },
    "FollowStopDistance": {
      "Value": 3,
      "Description": "Distance from the follow position at which the book stops when near the evoker"
    },
    "NameTranslationKey": {
      "Value": "server.npcRoles.Template.name",
      "Description": "Translation key for NPC name display"
    }
  },
  "DropList": { "Compute": "DropList" },
  "Appearance": {"Compute": "Appearance"},
  "FlockSpawnTypes": {"Compute": "FlockArray"},
  "FlockAllowedNPC": {"Compute": "FlockArray"},
  "DisableDamageFlock": true,
  "ApplySeparation": true,
  "SeparationDistance": 0.5,
  "SeparationWeight": 0.5,
  "SeparationDistanceTarget": 1,
  "SeparationNearRadiusTarget": 1.2,
  "InventorySize": 0,
  "HotbarSize": 3,
  "OffHandSlots": 0,
  "ApplyAvoidance": true,
  "AvoidanceMode": "Slowdown",
  "NameTranslationKey": {"Compute": "NameTranslationKey"},
  "InitialMotionController": "Walk",
  "MotionControllerList": [
    {
      "$Comment": "Only used right after spawning or when touching the ground, the creature takes off right away",
      "Type": "Walk",
      "MaxWalkSpeed": 15,
      "Gravity": 10,
      "RunThreshold": 0.5,
      "MaxFallSpeed": 30,
      "MaxRotationSpeed": 360,
      "Acceleration": 20,
      "MinHover": 0.5,
      "MaxHover": 0.5,
      "HoverFreq": 10,
      "MaxClimbHeight": 3,
      "MaxDropHeight": 3
    },
    {
      "$Comment": "MinAirSpeed 0 lets the creature stop and hover in place instead of circling like a bird",
      "Type": "Fly",
      "MaxHorizontalSpeed": 15,
      "MaxClimbSpeed": 10,
      "MaxSinkSpeed": 8,
      "MinAirSpeed": 0,
      "Acceleration": 20,
      "Deceleration": 10,
      "MaxClimbAngle": 90,
      "MaxSinkAngle": 90,
      "MaxTurnSpeed": 180,
      "MaxRollAngle": 20,
      "MinHeightOverGround": 0.5,
      "MaxHeightOverGround": 1.0,
      "DesiredAltitudeWeight": 0.3
    }
  ],
  "MaxHealth": 100,
  "StateTransitions": [
    {
      "$Comment": "Clear",
      "States": [
        {
          "From": [ ],
          "To": [ ]
        }
      ],
      "Actions": [
        {
          "Type": "ReleaseTarget"
        },
        {
          "Type": "ResetInstructions"
        }
      ]
    }
  ],
  "Instructions": [
    {
      "$Comment": "Wand command: go to the target position. Placed before the states so it works in all of them",
      "Continue": true,
      "Sensor": {
        "Type": "Beacon",
        "Message": "EvokeTargetPosition",
        "Range": { "Compute": "MaxBeaconDistance" }
      },
      "Actions": [
        {
          "Type": "State",
          "State": "SeekPosition"
        }
      ]
    },
    {
      "$Comment": "Wand command: follow the evoker. Placed before the states so it works in all of them",
      "Continue": true,
      "Sensor": {
        "Type": "Beacon",
        "Message": "EvokeFollowLeader",
        "Range": { "Compute": "MaxBeaconDistance" }
      },
      "Actions": [
        {
          "Type": "State",
          "State": "Recall"
        }
      ]
    },
    {
      "$Comment": "After the Follow command, the target flies directly to the summoner through any block and returns to the Following command when nearby",
      "Sensor": {
        "Type": "State",
        "State": "Recall"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "MotionController",
            "MotionController": "Walk"
          },
          "Actions": [
            {
              "Type": "Evoke:SetMotionController",
              "MotionController": "Fly"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Evoke:EvokerPosition",
            "Range": 2
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Following"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "Evoke:Unstuck",
              "Speed": 8,
              "TurnRate": 10,
              "StartSpread": 90
            }
          ]
        }
      ]
    },
    {
      "$Comment": "After the wand command flies straight to 1.5 blocks above the target point through any block, then waits there",
      "Sensor": {
        "Type": "State",
        "State": "SeekPosition"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "MotionController",
            "MotionController": "Walk"
          },
          "Actions": [
            {
              "Type": "Evoke:SetMotionController",
              "MotionController": "Fly"
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Evoke:ReadPosition",
            "Range": { "Compute": "MaxBeaconDistance" },
            "MinRange": 0.3,
            "HeightOffset": 1.5
          },
          "Actions": [
            {
              "Type": "Evoke:Unstuck",
              "Speed": 8,
              "TurnRate": 10,
              "StartSpread": 90
            }
          ]
        },
        {
          "Sensor": {
            "Type": "Any"
          },
          "Actions": [
            {
              "Type": "SetLeashPosition",
              "ToCurrent": true
            },
            {
              "Type": "Evoke:ResetChestExploration"
            },
            {
              "Type": "State",
              "State": "Idle"
            }
          ]
        }
      ]
    },
    {
      "$Comment": "After the Search button of the book page, flies straight to above the chest that has the selected item through any block, then waits there",
      "Sensor": {
        "Type": "State",
        "State": "SearchItem"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "MotionController",
            "MotionController": "Walk"
          },
          "Actions": [
            {
              "Type": "Evoke:SetMotionController",
              "MotionController": "Fly"
            }
          ]
        },
        {
          "$Comment": "Flying to the chest",
          "Sensor": {
            "Type": "State",
            "State": ".Default"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Evoke:SearchedChestPosition",
                "Range": { "Compute": "MaxBeaconDistance" },
                "MinRange": 0.3,
                "HeightOffset": 1
              },
              "Actions": [
                {
                  "Type": "Evoke:Unstuck",
                  "UseSensorPosition": true,
                  "Speed": 8,
                  "TurnRate": 10,
                  "StartSpread": 90
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Evoke:SearchedChestPosition",
                "Range": 0.3,
                "HeightOffset": 1
              },
              "Actions": [
                {
                  "Type": "Evoke:MemorizeChest"
                },
                {
                  "$Comment": "The light rays stop at 7.5 of the 10 seconds above the chest, so they fade out before the book moves again",
                  "Type": "TimerStart",
                  "Name": "CodexRays",
                  "StartValueRange": [ 7.5, 7.5 ],
                  "RestartValueRange": [ 7.5, 7.5 ]
                },
                {
                  "Type": "State",
                  "State": ".Waiting"
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "Following"
                }
              ]
            }
          ]
        },
        {
          "$Comment": "Waits 10 seconds above the chest, then wanders around it",
          "Sensor": {
            "Type": "State",
            "State": ".Waiting"
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Evoke:SearchedChestPosition",
                "Range": { "Compute": "MaxBeaconDistance" },
                "MinRange": 3,
                "HeightOffset": 1
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "SearchItem.Default"
                }
              ]
            },
            {
              "$Comment": "Light rays coming out of the book while the CodexRays timer runs",
              "Continue": true,
              "Sensor": {
                "Type": "Timer",
                "Name": "CodexRays",
                "State": "Running"
              },
              "Instructions": [
                {
                  "Sensor": {
                    "Type": "Evoke:SearchedChestPosition",
                    "Range": 3,
                    "HeightOffset": 1
                  },
                  "Actions": [
                    {
                      "Type": "Timeout",
                      "Delay": [ 1, 1 ],
                      "DelayAfter": true,
                      "Action": {
                        "Type": "SpawnParticles",
                        "PositionSource": "Sensor",
                        "Offset": [ 0, 0.1, 0 ],
                        "ParticleSystem": "Evoke_Codex_Item_Found_Rays"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "$Comment": "White dust falling on the chest, signaling where the searched item is",
              "Continue": true,
              "Sensor": {
                "Type": "Evoke:SearchedChestPosition",
                "Range": 3,
                "HeightOffset": 1
              },
              "Actions": [
                {
                  "Type": "Timeout",
                  "Delay": [ 1, 1 ],
                  "DelayAfter": true,
                  "Action": {
                    "Type": "SpawnParticles",
                    "PositionSource": "Sensor",
                    "Offset": [ 0, 0.1, 0 ],
                    "ParticleSystem": "Evoke_Codex_Item_Found"
                  }
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Evoke:SearchedChestPosition",
                "Range": 3,
                "HeightOffset": 1
              },
              "Actions": [
                {
                  "Type": "Timeout",
                  "Delay": [ 10, 10 ],
                  "Action": {
                    "Type": "Sequence",
                    "Actions": [
                      {
                        "Type": "SetLeashPosition",
                        "ToCurrent": true
                      },
                      {
                        "Type": "Evoke:ResetChestExploration",
                        "ClearVisited": false
                      },
                      {
                        "Type": "State",
                        "State": "Idle"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": "Following"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "$Comment": "While not following the player, flies from chest to chest around the place it was sent to and memorizes only the chests it visited",
      "Sensor": {
        "Type": "State",
        "State": "Idle"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "MotionController",
            "MotionController": "Walk"
          },
          "Actions": [
            {
              "Type": "Evoke:SetMotionController",
              "MotionController": "Fly"
            }
          ]
        },
        {
          "$Comment": "Flying to the next chest not visited in the last 120 seconds",
          "Sensor": {
            "Type": "Evoke:FindChestToExplore",
            "HorizontalRange": { "Compute": "ChestHorizontalRange" },
            "VerticalRange": { "Compute": "ChestVerticalRange" },
            "RevisitDelay": 120,
            "Range": { "Compute": "MaxBeaconDistance" },
            "MinRange": 0.3,
            "HeightOffset": 1
          },
          "Actions": [
            {
              "Type": "Evoke:Unstuck",
              "UseSensorPosition": true,
              "Speed": 4,
              "TurnRate": 6,
              "StartSpread": 45
            }
          ]
        },
        {
          "$Comment": "Reads the chest for a moment before memorizing it",
          "Sensor": {
            "Type": "Evoke:FindChestToExplore",
            "HorizontalRange": { "Compute": "ChestHorizontalRange" },
            "VerticalRange": { "Compute": "ChestVerticalRange" },
            "RevisitDelay": 120,
            "Range": 0.3,
            "HeightOffset": 1
          },
          "ActionsBlocking": true,
          "Actions": [
            {
              "Type": "PlayAnimation",
              "Slot": "Action",
              "Animation": "ReadChest"
            },
            {
              "Type": "Evoke:OpenChestAnimation",
              "Target": "Explore"
            },
            {
              "Type": "Timeout",
              "Delay": [ 1.5, 1.5 ],
              "Action": {
                "Type": "Sequence",
                "Actions": [
                  {
                    "Type": "Evoke:OpenChestAnimation",
                    "Target": "Explore",
                    "Reverse": true
                  },
                  {
                    "Type": "Evoke:MemorizeChest",
                    "Target": "Explore"
                  },
                  {
                    "Type": "PlayAnimation",
                    "Slot": "Action"
                  }
                ]
              }
            }
          ]
        },
        {
          "$Comment": "With every chest read, wanders randomly around the area like the Hex Broom",
          "Sensor": {
            "Type": "Any"
          },
          "BodyMotion": {
            "Type": "Sequence",
            "Looped": true,
            "Motions": [
              {
                "Type": "Timer",
                "Time": [ 16, 20 ],
                "Motion": {
                  "Type": "WanderInCircle",
                  "Radius": 16,
                  "MaxHeadingChange": 45,
                  "RelativeSpeed": 0.15
                }
              },
              {
                "Type": "Timer",
                "Time": [ 0.5, 1.5 ],
                "Motion": {
                  "Type": "Nothing"
                }
              },
              {
                "Type": "Timer",
                "Time": [ 14, 18 ],
                "Motion": {
                  "Type": "WanderInCircle",
                  "Radius": 5,
                  "MaxHeadingChange": 45,
                  "RelativeSpeed": 0.15
                }
              },
              {
                "Type": "Timer",
                "Time": [ 0.5, 1.5 ],
                "Motion": {
                  "Type": "Nothing"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "$Comment": "Switches back to Walk if the creature touches the ground while flying, so it can take off again",
      "Continue": true,
      "Sensor": {
        "Type": "And",
        "Sensors": [
          {
            "Type": "MotionController",
            "MotionController": "Fly"
          },
          {
            "Type": "OnGround"
          }
        ]
      },
      "Actions": [
        {
          "Type": "Evoke:SetMotionController",
          "MotionController": "Walk"
        }
      ]
    },
    {
      "$Comment": "While stuck against a block, flies straight through the blocks to the evoker (or to the wand target)",
      "Continue": true,
      "Sensor": {
        "Type": "Evoke:IsStuck",
        "Delay": 0.15,
        "MinProgress": 0.5,
        "MaxStuckTime": 2
      },
      "Actions": [
        {
          "Type": "Evoke:Unstuck",
          "Speed": 4
        }
      ]
    },
    {
      "$Comment": "Takes off whenever the creature is not flying",
      "Sensor": {
        "Type": "MotionController",
        "MotionController": "Walk"
      },
      "BodyMotion": {
        "Type": "TakeOff",
        "JumpSpeed": 4
      }
    },
    {
      "$Comment": "Adds the entity to the flock of the first player it finds",
      "Continue": true,
      "Instructions": [
        {
          "$Comment": "Add creature to flock",
          "Continue": true,
          "Sensor": {
            "Type": "Self",
            "Filters": [
              {
                "Type": "Flock",
                "FlockStatus": "NotMember"
              }
            ]
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Player",
                "Range": 15,
                "Filters": [
                  {
                    "Type": "Evoke:IsEvoker"
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "JoinFlock",
                  "ForceJoin": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Entity movement",
      "Instructions": [
        {
          "Sensor": {
            "Type": "State",
            "State": "Following"
          },
          "Instructions": [
            {
              "$Comment": "Prevents the NPC from losing sight of the player",
              "Continue": true,
              "Sensor": {
                "Type": "Player",
                "Range": { "Compute": "MaxBeaconDistance" },
                "LockOnTarget": true,
                "Filters": [
                  {
                    "Type": "Evoke:IsEvoker"
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "Nothing"
                }
              ]
            },
            {
              "$Comment": "Less than 5 block away from the leader, flies at the player's head height, in the formation chosen by FollowFormation",
              "Sensor": {
                "Type": "Evoke:EvokerPosition",
                "Range": 6,
                "HeightOffset": 1.2,
                "LeadDistance": 5,
                "LeadFullSpeed": 5,
                "LeadSideOffset": 1.5,
                "Formation": { "Compute": "FollowFormation" },
                "FormationDistance": { "Compute": "FollowDistance" },
                "FormationSide": { "Compute": "FollowSide" }
              },
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 5,
                "StopDistance": { "Compute": "FollowStopDistance" },
                "RelativeSpeed": 0.6,
                "DesiredAltitudeWeight": 0
              }
            },
            {
              "$Comment": "Less than 15 blocks away from the leader, flies at the player's head height, in the formation chosen by FollowFormation",
              "Sensor": {
                "Type": "Evoke:EvokerPosition",
                "Range": 15,
                "HeightOffset": 1.5,
                "LeadDistance": 4,
                "LeadFullSpeed": 5,
                "LeadSideOffset": 1.5,
                "Formation": { "Compute": "FollowFormation" },
                "FormationDistance": { "Compute": "FollowDistance" },
                "FormationSide": { "Compute": "FollowSide" }
              },
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 4,
                "StopDistance": 2,
                "RelativeSpeed": 0.8,
                "DesiredAltitudeWeight": 0
              }
            },
            {
              "$Comment": "Keeps the target locked for the teleport below",
              "Continue": true,
              "Sensor": {
                "Type": "Player",
                "Range": { "Compute": "MaxBeaconDistance" },
                "LockOnTarget": true,
                "Filters": [
                  {
                    "Type": "Evoke:IsEvoker"
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "Nothing"
                }
              ]
            },
            {
              "$Comment": "Teleports to the leader if more than 15 blocks away",
              "Sensor": {
                "Type": "Target",
                "Filters": [
                  {
                    "Type": "Evoke:IsEvoker"
                  }
                ]
              },
              "BodyMotion": {
                "Type": "Evoke:Teleport",
                "MinYOffset": 1.0,
                "OffsetRange": [2, 3],
                "OffsetSector": 2,
                "Orientation": "TowardsTarget"
              },
              "Actions": [
                {
                  "Type": "SpawnParticles",
                  "Offset": [ 0, 0.5, 0 ],
                  "ParticleSystem": "Effect_Death",
                  "Once": true
                },
                {
                  "Type": "Timeout",
                  "Delay": [ 2, 2 ],
                  "DelayAfter": true
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "$Comment": "Any player opens the item search page, only the evoker despawns the Hex Creature while crouching",
    "Instructions": [
      {
        "Sensor": {
          "Type": "Evoke:Interactor",
          "Filters": [
            {
              "Type": "Evoke:IsEvoker"
            },
            {
              "Type": "Evoke:IsTargetCrouch"
            }
          ]
        },
        "Instructions": [
          {
            "Continue": true,
            "Sensor": {
              "Type": "Any"
            },
            "Actions": [
              {
                "Type": "SetInteractable",
                "Interactable": true,
                "Hint": "evoke.interactionHints.despawn"
              }
            ]
          },
          {
            "Sensor": {
              "Type": "HasInteracted"
            },
            "Actions": [
              {
                "Type": "Evoke:DespawnHC",
                "DropHexItem": true
              }
            ]
          }
        ]
      },
      {
        "Continue": true,
        "Sensor": {
          "Type": "Any"
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true,
            "Hint": "evoke.interactionHints.searchItem"
          }
        ]
      },
      {
        "Sensor": {
          "Type": "HasInteracted"
        },
        "Actions": [
          {
            "Type": "Evoke:OpenArcaneCodexSearch"
          }
        ]
      }
    ]
  }
}
