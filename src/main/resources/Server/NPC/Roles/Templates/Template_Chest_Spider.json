{
  "StartState": "CheckTasks",
  "Type": "Abstract",
  "Invulnerable": false,
  "Parameters": {
    "Appearance": {
      "Value": "Chest_Spider",
      "Description": "Model to be used."
    },
    "DropHexItem": {
      "Value": "Hex_Mannequin_Block",
      "Description": "Drop from Hex Creature"
    },
    "OffHand": {
      "Value": "",
      "Description": "OffHand items"
    },
    "holdableItems": {
      "Value": [ "Furniture_Crude_Torch" ],
      "Description": "Items that can be held"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "NameTranslationKey": {
      "Value": "Chest Spider",
      "Description": "Translation key for NPC name display"
    }
  },
  "IsMemory": false,
  "BreathesInWater": true,
  "DropList": { "Compute": "DropList" },
  "Appearance": {"Compute": "Appearance"},
  "DefaultNPCAttitude": "Ignore",
  "DefaultPlayerAttitude": "Ignore",
  "ApplySeparation": true,
  "SeparationDistance": 1.0,
  "SeparationWeight": 0.6,
  "InventorySize": 18,
  "HotbarSize": 3,
  "OffHandSlots": 1,
  "DefaultOffHandSlot": 0,
  "PickupDropOnDeath": true,
  "MaxHealth": 200,
  "KnockbackScale": 0.5,
  "NameTranslationKey": {"Compute": "NameTranslationKey"},
  "MotionControllerList": [
    {
      "Type": "Walk",
      "MaxWalkSpeed": 7,
      "Gravity": 10,
      "RunThreshold": 0.3,
      "MaxFallSpeed": 15,
      "MaxRotationSpeed": 360,
      "Acceleration": 8,
      "MaxClimbHeight": 3,
      "MaxDropHeight": 5
    }
  ],
  "StateTransitions": [
    {
      "$Comment": "Clear",
      "States": [
        {
          "From": [ ],
          "To": [ ]
        }
      ],
      "Actions": [
        {
          "Type": "ReleaseTarget"
        },
        {
          "Type": "ResetInstructions"
        },
        {
          "Type": "PlayAnimation",
          "Slot": "Status"
        }
      ]
    }
  ],
  "Instructions": [
    {
      "$Comment": "Beacon wand command",
      "Continue": true,
      "Instructions": [
        {
          "$Comment": "Store target position",
          "Sensor": {
            "Type": "Beacon",
            "Message": "EvokeTargetPosition",
            "Range": 100
          },
          "Actions": [
            {
              "Type": "State",
              "State": "SeekPosition"
            }
          ]
        },
        {
          "$Comment": "Follow the leader",
          "Sensor": {
            "Type": "Beacon",
            "Message": "EvokeFollowLeader",
            "Range": 100
          },
          "Actions": [
            {
              "Type": "State",
              "State": "Following"
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Go to target position",
      "Sensor": {
        "Type": "State",
        "State": "SeekPosition"
      },
      "Instructions": [
        {
          "Continue": true,
          "Sensor": {
            "Type": "EvokeReadPosition",
            "Range": 30
          },
          "BodyMotion": {
            "Type": "Seek",
            "SlowDownDistance": 3,
            "StopDistance": 0.1,
            "RelativeSpeed": 0.8
          }
        },
        {
          "Sensor": {
            "Type": "EvokeReadPosition",
            "Range": 2
          },
          "Actions": [
            {
              "Type": "State",
              "State": "CheckTasks.Default"
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Less than 1 block away from the player",
      "Sensor": {
        "Type": "Player",
        "Range": 1
      },
      "BodyMotion": {
        "Type": "MaintainDistance",
        "DesiredDistanceRange": [1.5, 1.5],
        "MoveThreshold": 0.2,
        "RelativeForwardsSpeed": 0.6,
        "RelativeBackwardsSpeed": 0.3
      }
    },
    {
      "$Comment": "Head motion",
      "Continue": true,
      "Sensor": {
        "Type": "Player",
        "Range": 2,
        "Filters": [
          {
            "Type": "ViewSector",
            "ViewSector": 120
          }
        ]
      },
      "HeadMotion": {
        "Type": "Watch",
        "RelativeTurnSpeed": 0.5
      }
    },
    {
      "$Comment": "Entity movement",
      "Sensor": {
        "Type": "State",
        "State": "Following"
      },
      "Instructions": [
        {
          "$Comment": "Less than 40 blocks away from the leader",
          "Sensor": {
            "Type": "Player",
            "Range": 40,
            "LockOnTarget": true,
            "Filters": [
              {
                "Type": "IsEvoker"
              }
            ]
          },
          "Instructions": [
            {
              "Sensor": {
                "Type": "Target"
              },
              "BodyMotion": {
                "Type": "Seek",
                "SlowDownDistance": 5,
                "StopDistance": 3,
                "RelativeSpeed": 0.5
              }
            }
          ]
        },
        {
          "$Comment": "Teleports to the leader if more than 40 blocks away",
          "Sensor": {
            "Type": "Target",
            "Filters": [
              {
                "Type": "IsEvoker"
              }
            ]
          },
          "BodyMotion": {
            "Type": "Teleport",
            "OffsetRange": [2, 3],
            "OffsetSector": 2,
            "Orientation": "TowardsTarget"
          },
          "Actions": [
            {
              "Type": "SpawnParticles",
              "Offset": [ 0, 0.5, 0 ],
              "ParticleSystem": "Effect_Death",
              "Once": true
            },
            {
              "Type": "Timeout",
              "Delay": [ 2, 2 ],
              "DelayAfter": true
            }
          ]
        }
      ]
    },
    {
      "$Comment": "Check tasks to do",
      "Continue": true,
      "Sensor": {
        "Type": "State",
        "State": "CheckTasks"
      },
      "Instructions": [
        {
          "$Comment": "Verify item being held",
          "Sensor": {
            "Type": "State",
            "State": ".Default"
          },
          "Instructions": [
            {
              "$Comment": "Spawns a baby spider if it has less than 3",
              "Sensor": {
                "Type": "Self",
                "Once": true,
                "Filters": [
                  {
                    "Type": "EvokeFilterNeedsMoreMinions",
                    "DesiredQuantity": 3
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "EvokeSpawnMinion",
                  "EntityId": "Baby_Chest_Spider"
                }
              ]
            },
            {
              "$Comment": "Checks if the inventory is full and if there is a chest nearby",
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "EvokeIsInventoryFull",
                    "Inventories": ["Hotbar", "Storage"]
                  },
                  {
                    "Type": "EvokeFilterHasChestNearby",
                    "HorizontalRange": 10,
                    "VerticalRange": 3
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".StoreItems"
                }
              ]
            },
            {
              "$Comment": "Checks if you are holding a sickle and if has harvestable crop",
              "Sensor": {
                "Type": "Self",
                "Filters": [
                  {
                    "Type": "ItemInHand",
                    "Items": [ "Tool_Sickle*" ]
                  },
                  {
                    "Type": "EvokeFilterHasHarvestableCrop",
                    "HorizontalRange": 10,
                    "VerticalRange": 3
                  }
                ]
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Harvest"
                }
              ]
            },
            {
              "$Comment": "Checks if you are holding a sickle",
              "Sensor": {
                "Type": "Any"
              },
              "Actions": [
                {
                  "Type": "State",
                  "State": ".Standby"
                }
              ]
            }
          ]
        },
        {
          "$Comment": "Search for a chest that has available slots",
          "Sensor": {
            "Type": "State",
            "State": ".StoreItems"
          },
          "Instructions": [
            {
              "Reference": "Component_Evoke_Store_Items",
              "Modify": {
                "_ExportStates": ["SeekPosition"]
              }
            }
          ]
        },
        {
          "$Comment": "Search for a plantation that is ready to harvest",
          "Sensor": {
            "Type": "State",
            "State": ".Harvest"
          },
          "Instructions": [
            {
              "Reference": "Component_Evoke_Harvest",
              "Modify": {
                "_ExportStates": ["SeekPosition"]
              }
            }
          ]
        },
        {
          "$Comment": "Standby state",
          "Sensor": {
            "Type": "State",
            "State": ".Standby"
          },
          "Actions": [
            {
              "Type": "Timeout",
              "Delay": [3, 3],
              "Action": {
                "Type": "State",
                "State": "CheckTasks"
              }
            }
          ]
        }
      ]
    }
  ],
  "InteractionInstruction": {
    "$Comment": "Opens the Hex Creature profile when interacted with",
    "Instructions": [
      {
        "Continue": true,
        "Sensor": {
          "Type": "Any"
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true
          }
        ]
      },
      {
        "Sensor": {
          "Type": "HasInteracted"
        },
        "Instructions": [
          {
            "Actions": [
              {
                "Type": "OpenHCProfile"
              }
            ]
          }
        ]
      }
    ]
  }
}