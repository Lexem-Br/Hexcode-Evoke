{
  "$Comment": "Harvest the dry soil",
  "Class": "Instruction",
  "Parameters": {
    "_ImportStates": ["Main"]
  },
  "Content":  {
    "Instructions": [
      {
        "$Comment": "Stops watering if the watering can is no longer in hand",
        "Sensor": {
          "Type": "Not",
          "Sensor": {
            "Type": "Self",
            "Filters": [
              {
                "Type": "ItemInHand",
                "Items": [ "Tool_Watering_Can", "*Tool_Watering_Can_State_Filled_Water" ]
              }
            ]
          }
        },
        "Actions": [
          {
            "Type": "ParentState",
            "State": "Main"
          }
        ]
      },
      {
        "$Comment": "Stops if the watering can is empty and there is no water nearby to fill it",
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "Self",
              "Filters": [
                {
                  "Type": "Evoke:HasWateringCan",
                  "Filled": false
                }
              ]
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "Evoke:WaterSourceFinder",
                "HorizontalRange": 10,
                "VerticalRange": 3
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "ParentState",
            "State": "Main"
          }
        ]
      },
      {
        "$Comment": "Fill the empty watering can when close to the water",
        "Sensor": {
          "Type": "Evoke:WaterSourceFinder",
          "HorizontalRange": 2,
          "VerticalRange": 3
        },
        "HeadMotion": {
          "Type": "Aim",
          "RelativeTurnSpeed": 1
        },
        "ActionsBlocking": true,
        "Actions": [
          {
            "Type": "Timeout",
            "Delay": [0.4, 0.6],
            "Action": {
              "Type": "Sequence",
              "Actions": [
                {
                  "Type": "Evoke:RefillWateringCan"
                },
                {
                  "Type": "PlaySound",
                  "SoundEventId": "SFX_Water_MoveIn"
                }
              ]
            }
          },
          {
            "Type": "Timeout",
            "Delay": [0.8, 1.0]
          }
        ]
      },
      {
        "$Comment": "Go to the nearest water to fill the empty watering can",
        "Sensor": {
          "Type": "Evoke:WaterSourceFinder",
          "HorizontalRange": 10,
          "VerticalRange": 3
        },
        "BodyMotion": {
          "Type": "Seek",
          "SlowDownDistance": 2.0,
          "StopDistance": 1.5,
          "RelativeSpeed": 0.5
        },
        "HeadMotion": {
          "Type": "Aim",
          "RelativeTurnSpeed": 1
        }
      },
      {
        "$Comment": "Search for dry soil",
        "Continue": true,
        "Sensor":  {
          "Type": "Evoke:WettableSoilFinder",
          "HorizontalRange": 10,
          "VerticalRange": 3
        },
        "BodyMotion": {
          "Type": "Seek",
          "SlowDownDistance": 2.0,
          "StopDistance": 0.9,
          "RelativeSpeed": 0.5
        }
      },
      {
        "$Comment": "Water soil",
        "Continue": true,
        "Sensor": {
          "Type": "Evoke:WettableSoilFinder",
          "HorizontalRange": 2,
          "VerticalRange": 3
        },
        "ActionsBlocking": true,
        "Actions": [
          {
            "Type": "PlayAnimation",
            "Slot": "Status",
            "Animation": "Water"
          },
          {
            "Type": "Timeout",
            "Delay": [0.6, 0.8],
            "Action": {
              "Type": "Sequence",
              "Actions": [
                {
                  "Type": "Evoke:WaterSoil"
                },
                {
                  "Type": "PlaySound",
                  "SoundEventId": "SFX_Water_MoveOut"
                },
                {
                  "Type": "PlayAnimation",
                  "Slot": "Status"
                }
              ]
            }
          },
          {
            "Type": "Timeout",
            "Delay": [1.2, 1.5]
          }
        ]
      },
      {
        "$Comment": "If no dry soil is found, return to the initial position",
        "Sensor": {
          "Type": "And",
          "Sensors": [
            {
              "Type": "Not",
              "Sensor": {
                "Type": "Evoke:WettableSoilFinder",
                "HorizontalRange": 10,
                "VerticalRange": 3
              }
            },
            {
              "Type": "Not",
              "Sensor": {
                "Type": "Evoke:ReadPosition",
                "Range": 1
              }
            }
          ]
        },
        "Actions": [
          {
            "Type": "ParentState",
            "State": "Main"
          }
        ]
      }
    ]
  },
  "Type": "Component"
}