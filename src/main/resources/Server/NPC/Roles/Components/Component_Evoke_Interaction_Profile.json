{
  "$Comment": "Opens the Hex Creature profile when interacted with",
  "Class": "Instruction",
  "Content": {
    "Instructions": [
      {
        "Continue": true,
        "Sensor": {
          "Type": "Any"
        },
        "Actions": [
          {
            "Type": "SetInteractable",
            "Interactable": true
          }
        ]
      },
      {
        "Sensor": {
          "Type": "HasInteracted"
        },
        "Instructions": [
          {
            "Actions": [
              {
                "Type": "Evoke:OpenHCProfile"
              }
            ]
          }
        ]
      }
    ]
  },
  "Type": "Component"
}
