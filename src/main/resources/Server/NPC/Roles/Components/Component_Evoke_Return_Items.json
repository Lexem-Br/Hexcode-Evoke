{
  "$Comment": "Search for an item on the task list",
  "Class": "Instruction",
  "Parameters": {
    "_ImportStates": ["Main"],
    "SearchTaskRange": {
      "Value": 16,
      "Description": "Range around the mother to create search tasks after returning the items, 0 creates none"
    }
  },
  "DefaultState": ".ReturnTheItems",
  "Content":  {
    "Instructions": [
      {
        "$Comment": "Return the items to the owner",
        "Sensor": {
          "Type": "State",
          "State": ".ReturnTheItems"
        },
        "Instructions": [
          {
            "$Comment": "Teleports next to the mother when it can't reach her",
            "Sensor": {
              "Type": "Evoke:ChestTaskStuck",
              "Target": "Owner"
            },
            "Actions": [
              {
                "Type": "SpawnParticles",
                "Offset": [0, 0.5, 0],
                "ParticleSystem": "Effect_Death"
              },
              {
                "Type": "Evoke:AbandonMinionTask",
                "ForgetChest": false,
                "TeleportDistance": 2
              }
            ]
          },
          {
            "$Comment": "Search for the owner",
            "Continue": true,
            "Sensor": {
              "Type": "Mob",
              "Range": 100,
              "Filters": [
                {
                  "Type": "Evoke:IsOwner"
                }
              ]
            },
            "BodyMotion": {
              "Type": "Seek",
              "SlowDownDistance": 2.0,
              "StopDistance": 1.0,
              "RelativeSpeed": 0.5
            }
          },
          {
            "$Comment": "Is the owner nearby",
            "Sensor": {
              "Type": "Mob",
              "Range": 2,
              "LockOnTarget": true,
              "Filters": [
                {
                  "Type": "Evoke:IsOwner"
                },
                {
                  "Type": "Evoke:CanTransferItemsToTargetNPC"
                }
              ]
            },
            "ActionsBlocking": true,
            "Actions": [
              {
                "Type": "PlayAnimation",
                "Slot": "Status",
                "Animation": "InteractAndChestOpen"
              },
              {
                "Type": "PlaySound",
                "SoundEventId": "SFX_Chest_Wooden_Open",
                "Once": true
              },
              {
                "Type": "Evoke:TargetPlayAnimation",
                "Slot": "Status",
                "Animation": "ChestOpen"
              },
              {
                "Type": "Timeout",
                "Delay": [1, 2],
                "Action": {
                  "Type": "Sequence",
                  "Actions": [
                    {
                      "Type": "PlaySound",
                      "SoundEventId": "SFX_Chest_Wooden_Close"
                    },
                    {
                      "Type": "Evoke:TransferItemsToTargetNPC"
                    },
                    {
                      "Type": "Evoke:MinionCreateSearchTasks",
                      "HorizontalRange": { "Compute": "SearchTaskRange" },
                      "VerticalRange": 4
                    },
                    {
                      "Type": "PlayAnimation",
                      "Slot": "Status"
                    },
                    {
                      "Type": "Evoke:TargetPlayAnimation",
                      "Slot": "Status"
                    },
                    {
                      "Type": "ParentState",
                      "State": "Main"
                    }
                  ]
                }
              }
            ]
          },
          {
            "$Comment": "If the item was not found with the owner, remove the task from the minion",
            "Sensor": {
              "Type": "Mob",
              "Range": 2,
              "LockOnTarget": true,
              "Filters": [
                {
                  "Type": "Evoke:IsOwner"
                },
                {
                  "Type": "Evoke:CanTransferItemsToTargetNPC",
                  "Reverse": true
                }
              ]
            },
            "Actions": [
              {
                "Type": "State",
                "State": ".WaitingSlot"
              }
            ]
          }
        ]
      },
      {
        "$Comment": "Waiting to have space to return the item",
        "Sensor": {
          "Type": "State",
          "State": ".WaitingSlot"
        },
        "Actions": [
          {
            "Type": "Timeout",
            "Delay": [5, 5],
            "Action": {
              "Type": "State",
              "State": ".ReturnTheItems"
            }
          }
        ]
      }
    ]
  },
  "Type": "Component"
}