$C = "../Common.ui";
$Sounds = "../Sounds.ui";

@CaptionStyle = LabelStyle(
  FontSize: 14,
  TextColor: #9aa7b2,
  Wrap: true
);

@SlotGridStyle = ItemGridStyle(
  SlotSpacing: 4,
  SlotSize: 64,
  SlotIconSize: 54,
  SlotBackground: "../Icons/slotBackground.png",
  QuantityPopupSlotOverlay: "../Icons/slotHighlight.png",
  BrokenSlotBackgroundOverlay: "../Icons/brokenBackground.png",
  BrokenSlotIconOverlay: "../Icons/brokenWrench.png",
  CooldownOverlay: "../Icons/cooldownOverlay.png",
  DefaultItemIcon: "../Icons/circleIcon.png",
  DurabilityBar: "../Icons/durabilityBar.png",
  DurabilityBarBackground: "../Icons/durabilityBarBackground.png",
  DurabilityBarAnchor: (
    Bottom: 8,
    Left: 8,
    Width: 48,
    Height: 3
  ),
  DurabilityBarColorStart: #a63232,
  DurabilityBarColorEnd: #63b649,
  EphemeralIconPatch: "../Icons/circleIcon.png",
  EphemeralIconAnchor: (
    Bottom: 40,
    Left: 40,
    Width: 18,
    Height: 18
  ),
  ItemStackHoveredSound: (
    SoundPath: $Sounds.@ButtonsLightHover,
    Volume: 6
  )
);

@SlotGrid = ItemGrid {
  HitTestVisible: true;
  Style: @SlotGridStyle;
  SlotsPerRow: 1;
  RenderItemQualityBackground: true;
  AreItemsDraggable: true;
  DisplayItemQuantity: true;
  ShowScrollbar: false;
  InfoDisplay: None;
};

@EquipmentColumn = Group {
  LayoutMode: Top;
  Anchor: (Width: 70, Height: 110);
};

@EquipmentCaption = Group {
  LayoutMode: Middle;
  Anchor: (Height: 40, Width: 64);
};

$C.@PageOverlay {}

Group {
    Anchor: (Full: 0);
    LayoutMode: MiddleCenter;

    Group {
         Anchor: (Full: 0);
         LayoutMode: CenterMiddle;

         Group #LeftPanel {
            Anchor: (Width: 700, Height: 600);

            $C.@DecoratedContainer {
                Anchor: (Full: 0);

                #Title {
                    $C.@Title {
                        @Text = %evoke.profile.title;
                    }
                }

                #Content {
                    Group {
                        Group {
                            LayoutMode: Left;
                            ItemSlot #HCIcon {
                                ItemId: "Hex_Mannequin_Block";
                                Anchor: (Width: 80, Height: 80);
                            }

                            Group {
                                LayoutMode: MiddleCenter;
                                Label #HCName {
                                    Text: "";
                                    Anchor: (Width: 250, Height: 25);
                                    Style: (FontSize: 18, RenderBold: true, VerticalAlignment: Center);
                                    Padding: (Left: 12);
                                }
                                Label #EvokerName {
                                    Text: "";
                                    Anchor: (Width: 250, Height: 25);
                                    Style: (FontSize: 14, VerticalAlignment: Center);
                                    Padding: (Left: 12);
                                }
                            }
                        }

                        Group #DespawnButtonContainer {
                            LayoutMode: Right;
                            Padding: (Right: 10);
                            Visible: false;

                            $C.@SmallSecondaryTextButton #DespawnButton {
                                @Anchor = (Width: 110, Height: 50);
                                @Text = %evoke.profile.despawn;
                            }
                        }
                    }

                    Group { Anchor: (Height: 8); }

                    Group #EssenceSection {
                        Anchor: (Height: 24);
                        LayoutMode: Left;
                        Padding: (Left: 10);

                        ItemIcon #EssenceIcon {
                            ItemId: "Ingredient_Life_Essence";
                            Anchor: (Width: 22, Height: 22);
                        }

                        Group { Anchor: (Width: 6); }

                        Label #EssenceStored {
                            Text: "";
                            Anchor: (Height: 24);
                            Style: (FontSize: 14, RenderBold: true, VerticalAlignment: Center);
                        }

                        Group { Anchor: (Width: 16); }

                        Label #EssenceDrain {
                            Text: "";
                            Anchor: (Height: 24);
                            Style: (FontSize: 14, TextColor: #9aa7b2, VerticalAlignment: Center);
                        }
                    }

                    Group { Anchor: (Height: 8); }

                    Group {
                        LayoutMode: TopScrolling;
                        ScrollbarStyle: $C.@DefaultScrollbarStyle;
                        FlexWeight: 1;

                        Group #EquipmentRow {
                            LayoutMode: Left;
                            Anchor: (Width: 617, Height: 110);
                            Padding: (Left: 5);

                            @EquipmentColumn #NPCLeftHand {
                                @EquipmentCaption {
                                    Label {
                                        Style: @CaptionStyle;
                                        Text: %evoke.profile.leftHand;
                                    }
                                }

                                @SlotGrid #NPCLeftHandGrid {}
                            }

                            @EquipmentColumn #NPCRightHand {
                                @EquipmentCaption {
                                    Label {
                                        Style: @CaptionStyle;
                                        Text: %evoke.profile.rightHand;
                                    }
                                }

                                @SlotGrid #NPCRightHandGrid {}
                            }

                            Group #EquipmentSpacer { FlexWeight: 1; }

                            @EquipmentColumn #NPCArmorHead {
                                @EquipmentCaption {
                                    Label {
                                        Style: @CaptionStyle;
                                        Text: %evoke.profile.head;
                                    }
                                }

                                @SlotGrid #NPCArmorHeadGrid {}
                            }

                            @EquipmentColumn #NPCArmorChest {
                                @EquipmentCaption {
                                    Label {
                                        Style: @CaptionStyle;
                                        Text: %evoke.profile.chest;
                                    }
                                }

                                @SlotGrid #NPCArmorChestGrid {}
                            }

                            @EquipmentColumn #NPCArmorHands {
                                @EquipmentCaption {
                                    Label {
                                        Style: @CaptionStyle;
                                        Text: %evoke.profile.hands;
                                    }
                                }

                                @SlotGrid #NPCArmorHandsGrid {}
                            }

                            @EquipmentColumn #NPCArmorLegs {
                                @EquipmentCaption {
                                    Label {
                                        Style: @CaptionStyle;
                                        Text: %evoke.profile.legs;
                                    }
                                }

                                @SlotGrid #NPCArmorLegsGrid {}
                            }
                        }

                        Group #NPCHotbarSection {
                            LayoutMode: Top;
                            Padding: (Left: 5, Top: 12);

                            Label {
                                Anchor: (Height: 30, Left: 5);
                                Style: @CaptionStyle;
                                Text: %evoke.profile.hotbar;
                            }

                            @SlotGrid #NPCHotbarGrid {
                                SlotsPerRow: 9;
                            }
                        }

                        Group #NPCStorageSection {
                            LayoutMode: Top;
                            Padding: (Left: 5, Top: 12);

                            Label {
                                Anchor: (Height: 30, Left: 5);
                                Style: @CaptionStyle;
                                Text: %evoke.profile.inventory;
                            }

                            @SlotGrid #NPCStorageGrid {
                                SlotsPerRow: 9;
                            }
                        }
                    }
                }
            }
        }

        Group { Anchor: (Width: 20); }

         Group #RightPanel {
            Anchor: (Width: 700, Height: 600);

            $C.@DecoratedContainer {
                 Anchor: (Full: 0);

                #Title {
                    $C.@Title {
                      @Text = %evoke.profile.playerInventory;
                    }
                }

                 #Content {
                    Group {
                        LayoutMode: TopScrolling;
                        ScrollbarStyle: $C.@DefaultScrollbarStyle;

                        Group #PlayerHotbarSection {
                           LayoutMode: Top;
                           Padding: (Left: 20);

                           Label {
                             Anchor: (Height: 30);
                             Style: @CaptionStyle;
                             Text: %evoke.profile.hotbar;
                           }

                           @SlotGrid #PlayerHotbarGrid {
                               SlotsPerRow: 9;
                           }
                        }

                        Group #PlayerStorageSection {
                            LayoutMode: Top;
                            Padding: (Left: 20, Top: 24);

                            Label {
                                Anchor: (Height: 30);
                                Style: @CaptionStyle;
                                Text: %evoke.profile.storage;
                            }

                            @SlotGrid #PlayerStorageGrid {
                                SlotsPerRow: 9;
                            }
                        }

                        Group #PlayerBackpackSection {
                            LayoutMode: Top;
                            Padding: (Left: 20, Top: 24);

                            Label {
                                Anchor: (Height: 30);
                                Style: @CaptionStyle;
                                Text: %evoke.profile.backpack;
                            }

                            @SlotGrid #PlayerBackpackGrid {
                                SlotsPerRow: 9;
                            }
                        }
                    }
                 }
            }
         }
    }
}
